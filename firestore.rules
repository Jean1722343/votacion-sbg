rules_version = '2';

// Votación Group Growth · AWS Student Builder Group
// Acceso solo con el nombre (sin cuentas). Firestore guarda únicamente los votos:
// - cualquiera puede leerlos (los resultados son públicos para el equipo);
// - cada voto es un documento votes/{idVotante} con exactamente 2 candidatos distintos;
// - candidatos, votantes y apertura de la votación viven en /data del repo.
service cloud.firestore {
  match /databases/{database}/documents {

    function validVote(id) {
      let d = request.resource.data;
      return id.matches('^[a-z0-9-]{1,40}$')
        && d.keys().hasOnly(['voterName', 'picks', 'createdAt', 'updatedAt'])
        && d.voterName is string && d.voterName.size() <= 80
        && d.picks is list
        && d.picks.size() == 2
        && d.picks[0] is string && d.picks[1] is string
        && d.picks[0].matches('^[A-Za-z0-9_-]{1,40}$')
        && d.picks[1].matches('^[A-Za-z0-9_-]{1,40}$')
        && d.picks[0] != d.picks[1]
        && d.updatedAt == request.time;
    }

    match /votes/{id} {
      allow read: if true;
      allow create, update: if validVote(id);
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
