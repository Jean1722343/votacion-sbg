rules_version = '2';

// Votación Core Team · AWS Student Builder Group
// Cada votante crea su propia contraseña la primera vez (cuenta <id>@sbg-vota.app).
// - voters/{id}: marca pública de "ya creó contraseña"; solo la puede crear el dueño.
// - votes/{id}: solo el dueño escribe y lee su voto (2 candidatos distintos).
//   Solo el admin (jean) lee todos los votos: los resultados son privados.
// Candidatos, lista de votantes y apertura de la votación viven en /data del repo.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(id) {
      return request.auth != null
        && request.auth.token.email == id + '@sbg-vota.app';
    }

    function validVote() {
      let d = request.resource.data;
      return d.keys().hasOnly(['voterName', 'picks', 'createdAt', 'updatedAt'])
        && d.voterName is string && d.voterName.size() <= 80
        && d.picks is list
        && d.picks.size() == 2
        && d.picks[0] is string && d.picks[1] is string
        && d.picks[0].matches('^[A-Za-z0-9_-]{1,40}$')
        && d.picks[1].matches('^[A-Za-z0-9_-]{1,40}$')
        && d.picks[0] != d.picks[1]
        && d.updatedAt == request.time;
    }

    match /voters/{id} {
      allow read: if true;
      allow create: if isOwner(id)
        && request.resource.data.keys().hasOnly(['claimedAt'])
        && request.resource.data.claimedAt == request.time;
      allow update, delete: if false;
    }

    match /votes/{id} {
      allow read: if isOwner(id) || isOwner('jean');
      allow create, update: if isOwner(id) && validVote();
      allow delete: if isOwner(id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
