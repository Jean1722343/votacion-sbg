rules_version = '2';

// Votación Community Growth · AWS Student Builder Group
// - Votantes: lista pública (solo nombres) para el selector de inicio de sesión.
// - Todo lo demás solo lo ve un votante registrado o el admin.
// - Cada votante tiene un único documento de voto: exactamente 2 candidatos distintos que existan.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email; }
    function voterPath(id) { return /databases/$(database)/documents/voters/$(id); }
    function isVoter() { return signedIn() && exists(voterPath(email())); }
    function isAdmin() {
      return signedIn() && (
        email() == 'jean@sbg-vota.app' ||
        (exists(voterPath(email())) && get(voterPath(email())).data.isAdmin == true)
      );
    }
    function canRead() { return isVoter() || isAdmin(); }
    function votingOpen() {
      return get(/databases/$(database)/documents/config/app).data.votingOpen == true;
    }
    function candidateExists(id) {
      return exists(/databases/$(database)/documents/candidates/$(id));
    }
    function validVote() {
      let d = request.resource.data;
      return d.keys().hasOnly(['voterName', 'picks', 'createdAt', 'updatedAt'])
        && d.picks is list
        && d.picks.size() == 2
        && d.picks[0] is string && d.picks[1] is string
        && d.picks[0] != d.picks[1]
        && candidateExists(d.picks[0])
        && candidateExists(d.picks[1])
        && d.voterName == get(voterPath(email())).data.name
        && d.updatedAt == request.time;
    }

    match /voters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /candidates/{id} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /votes/{id} {
      allow read: if canRead();
      allow create, update: if isVoter() && id == email() && votingOpen() && validVote();
      allow delete: if isAdmin() || (isVoter() && id == email() && votingOpen());
    }
  }
}
